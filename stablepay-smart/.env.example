# === StablePay Deploy Config ===

# Plattformens adress (äger fabriken, tar emot avgifter)
PLATFORM_ADDRESS=

# RPC-endpoint för det nät du deployer till (t.ex. Base Sepolia)
RPC_URL=

# Privat nyckel för deploy-transaktionen (ALDRIG committa den riktiga!)
PRIVATE_KEY=

# Etherscan/Basescan API-nyckel för kontraktsverifiering
ETHERSCAN_API_KEY=

# USDC-adress som ska godkännas automatiskt vid deploy
# Base Sepolia USDC:
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
