DATABASE_URL="postgresql://stablepay:stablepay@localhost:5432/stablepay"

# Primary RPC — used for real-time event watchers.
# Free: sign up at https://www.alchemy.com/, create a Base Sepolia app, copy the HTTPS URL.
# Double-check the network in Alchemy's dashboard before copying — "Base Mainnet" and
# "Base Sepolia" look similar in the picker. The URL must start with
# "base-sepolia.g.alchemy.com", not "base-mainnet.g.alchemy.com" — this project only
# exists on Sepolia, so a mainnet URL will silently fail to find any contracts.
RPC_URL="https://base-sepolia.g.alchemy.com/v2/YOUR_KEY"

# Fallback RPC — used for backfill and catch-up sync (public, no rate limits).
# Already a working public endpoint — no account needed, leave as-is.
# Required. Do not leave this empty — an empty value causes viem to throw immediately.
RPC_URL_FALLBACK="https://sepolia.base.org"

FACTORY_ADDRESS="0x43F38b20bC9D10a0e0d58812BB30D6676003f97E"
FACTORY_DEPLOY_BLOCK="38641491"

PORT=3001

PLATFORM_ADDRESS="0x..."
PRIVATE_KEY="0x..."
ALLOWED_ORIGINS="http://localhost:3000"

# Optional — listener tuning. The defaults work; only change these if the RPC
# starts returning 429 (too many requests) or you want faster/slower health checks.
# CATCH_UP_BATCH_DELAY_MS=500            # pause between startup sync batches (5 escrows each)
# LISTENER_HEARTBEAT_INTERVAL_MS=15000   # how often the listener pings the RPC
# LISTENER_STALE_AFTER_MS=45000          # no successful ping for this long → /ready reports "degraded"
# LISTENER_RESTART_BASE_MS=2000          # first restart delay after a crash, doubles each attempt…
# LISTENER_RESTART_MAX_MS=30000          # …up to this maximum

# Optional — email notifications. Leave these commented out and the app works
# without email. To enable, uncomment and fill in. With Gmail, SMTP_PASS must be an
# App Password (Google Account → Security → 2-Step Verification → App passwords),
# not your normal password. Do not enable this on a public demo: anyone can register
# any email address, so the server would send mail to strangers.
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your16charapppassword"
# SMTP_FROM="you@gmail.com"          # optional, defaults to SMTP_USER
# ADMIN_EMAIL="you@gmail.com"        # receives dispute opened/escalated emails
# FRONTEND_URL="http://localhost:3000"  # used for the project link in each email
